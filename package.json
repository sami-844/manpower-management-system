{
  "name": "manpower-system",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:mutation": "pnpm --filter @mms/core test:mutation",
    "dev:api": "pnpm --filter @mms/api dev",
    "dev:web": "pnpm --filter @mms/web dev",
    "db:migrate": "pnpm --filter @mms/api db:migrate",
    "db:seed": "pnpm --filter @mms/api db:seed"
  },
  "engines": {
    "node": ">=22"
  }
}
