// Browser-only demo on Cloudflare Workers (DECISIONS A20): static assets only, free plan. The web app built
// with `--mode demo` answers its API calls in the browser from fictional data (apps/web/src/demo/server.ts).
// Deploy: `bunx wrangler login`, then `bun run deploy:demo`. The README button deploys the full client demo
// instead (wrangler.jsonc, A32), which also serves this same build under /demo/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manpower-management-system-demo",
  "compatibility_date": "2026-11-04",
  "assets": { "directory": "./apps/web/dist" }
}
